# Copy to .env and fill in the four required values. Everything else is optional: uncomment a line to change
# its default. Leave optional lines commented rather than empty, as an empty value is not the default.

# --- Required ---------------------------------------------------------------------------------------------------

# TenderTiger login: the tender list, documents and pre-qualification criteria are fetched with it
TENDERTIGER_EMAIL=you@example.com
TENDERTIGER_PASSWORD=
# Groq API key for the LLM analysis (https://console.groq.com/keys); without it every analysis fails
GROQ_API_KEY=
# Pinecone API key (https://app.pinecone.io > API Keys). Every tender's documents are indexed in their own
# namespace; without the key every analysis fails. Read from the environment / .env only: never put it in code.
PINECONE_API_KEY=

# --- TenderTiger --------------------------------------------------------------------------------------------------

# Seconds between two requests; the site's firewall blocks bursts with a browser check
# TENDERTIGER_REQUEST_GAP=3

# --- Pinecone: one namespace per tender, in one shared index ------------------------------------------------------

# The shared index (lowercase letters, digits and hyphens), created on first use
# PINECONE_INDEX_NAME=tender-processing
# Each tender's namespace is this prefix + TCNO: tcno-12345678
PINECONE_NAMESPACE_PREFIX=tcno-
# Where the index is created; the Starter plan allows only aws / us-east-1
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# Pinecone-hosted embedding model and dimension. Changing either needs a new PINECONE_INDEX_NAME and every
# namespace rebuilt (python scripts/migrate_to_pinecone.py --force)
# PINECONE_EMBED_MODEL=llama-text-embed-v2
# PINECONE_EMBED_DIMENSION=1024
# Vectors per upsert request
# PINECONE_UPSERT_BATCH=50
# Characters per chunk, and how many of them repeat the end of the chunk before
# CHUNK_SIZE=1600
# CHUNK_OVERLAP=200
# Chunks each retrieval query returns, and the most text (characters) sent to the LLM for one check
# RETRIEVAL_TOP_K=8
# RETRIEVAL_MAX_CHARS=60000
# Files read, and chunk batches embedded and upserted, at the same time
# INGEST_WORKERS=4

# --- LLM models on Groq (https://console.groq.com/docs/models) ---------------------------------------------------

# Checks the company against the criteria retrieved from the tender's index, also on a re-check
# ASSESSMENT_MODEL=openai/gpt-oss-120b
# Reads the pages of scanned PDFs; must accept images (vision)
# OCR_MODEL=qwen/qwen3.8-27b
# The deep analysis agents; each defaults to ASSESSMENT_MODEL
# DEEP_PROFILER_MODEL=openai/gpt-oss-120b
# DEEP_AUDIT_MODEL=openai/gpt-oss-120b
# DEEP_STATUS_REVIEW_MODEL=openai/gpt-oss-120b
# DEEP_SUPERVISOR_MODEL=openai/gpt-oss-120b
# Most tokens a model may write in one reply, reasoning included; a reply cut off at it fails the check
# LLM_MAX_OUTPUT_TOKENS=16384

# --- Documents ----------------------------------------------------------------------------------------------------

# Documents are stored in TARGET_DIRECTORY/<tcno>/
# TARGET_DIRECTORY=./downloads
# Seconds to wait for the document server to connect, and between received chunks
# DOWNLOAD_TIMEOUT=120
# Larger downloads are aborted
# MAX_DOWNLOAD_MB=500
# A tender file with more text is not indexed and is listed as not checked
# MAX_FILE_CHARS=300000

# --- Files --------------------------------------------------------------------------------------------------------

# The company profile every tender is checked against; edited on the page
# COMPANY_DETAILS_FILE=./company_details.md
# The TenderTiger filters that Default filters on the page applies; edited by hand
# DEFAULT_FILTERS_FILE=./default_filters.json
# Shortlisted / dropped decisions; defaults to TARGET_DIRECTORY/decisions.json
# DECISIONS_FILE=./downloads/decisions.json

# --- Server and logging -------------------------------------------------------------------------------------------

# Port for `python app.py` (uvicorn takes --port instead)
# PORT=5000
# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
# app.log is written here, rotated at 5 MB
# LOG_DIRECTORY=./logs
