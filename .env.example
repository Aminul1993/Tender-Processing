# Copy to .env and fill in the three required values. Everything else is optional: uncomment a line to change
# its default. Leave optional lines commented rather than empty, as an empty value is not the default.

# --- Required ---------------------------------------------------------------------------------------------------

# TenderTiger login: the tender list, documents and pre-qualification criteria are fetched with it
TENDERTIGER_EMAIL=you@example.com
TENDERTIGER_PASSWORD=
# ollama.com API key for the LLM analysis (https://ollama.com/settings/keys); without it every analysis fails
OLLAMA_API_KEY=

# --- TenderTiger --------------------------------------------------------------------------------------------------

# Seconds between two requests; the site's firewall blocks bursts with a browser check
# TENDERTIGER_REQUEST_GAP=3

# --- LLM models on ollama.com -------------------------------------------------------------------------------------

# Reads the documents for eligibility criteria (most of the tokens)
# SUMMARY_MODEL=gemma4:31b-cloud
# Checks the company against the criteria, also on a re-check
# ASSESSMENT_MODEL=gpt-oss:120b-cloud
# Reads the pages of scanned PDFs; must accept images (vision)
# OCR_MODEL=gemma4:31b-cloud
# The deep analysis agents; each defaults to ASSESSMENT_MODEL
# DEEP_PROFILER_MODEL=gpt-oss:120b-cloud
# DEEP_AUDIT_MODEL=gpt-oss:120b-cloud
# DEEP_STATUS_REVIEW_MODEL=gpt-oss:120b-cloud
# DEEP_SUPERVISOR_MODEL=gpt-oss:120b-cloud

# --- Documents ----------------------------------------------------------------------------------------------------

# Documents are stored in TARGET_DIRECTORY/<tcno>/
# TARGET_DIRECTORY=./downloads
# Seconds to wait for the document server to connect, and between received chunks
# DOWNLOAD_TIMEOUT=120
# Larger downloads are aborted
# MAX_DOWNLOAD_MB=500
# A tender file with more text (about 100k tokens) is not sent to the LLM and is listed as not checked
# MAX_FILE_CHARS=300000

# --- Files --------------------------------------------------------------------------------------------------------

# The company profile every tender is checked against; edited on the page
# COMPANY_DETAILS_FILE=./company_details.md
# Shortlisted / dropped decisions; defaults to TARGET_DIRECTORY/decisions.json
# DECISIONS_FILE=./downloads/decisions.json

# --- Server and logging -------------------------------------------------------------------------------------------

# Port for `python app.py` (uvicorn takes --port instead)
# PORT=5000
# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
# app.log is written here, rotated at 5 MB
# LOG_DIRECTORY=./logs
