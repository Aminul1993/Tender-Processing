# Copy to .env and fill in the four required values. Everything else is optional: uncomment a line to change
# its default. Leave optional lines commented rather than empty, as an empty value is not the default.

# --- Required ---------------------------------------------------------------------------------------------------

# TenderTiger login: the tender list, documents and pre-qualification criteria are fetched with it
TENDERTIGER_EMAIL=you@example.com
TENDERTIGER_PASSWORD=
# Groq API key for the LLM analysis (https://console.groq.com/keys); without it every analysis fails
GROQ_API_KEY=
# Pinecone API key (https://app.pinecone.io > API Keys). Every tender's documents are indexed in their own
# namespace; without the key every analysis fails. Read from the environment / .env only: never put it in code.
PINECONE_API_KEY=

# --- TenderTiger --------------------------------------------------------------------------------------------------

# Seconds between two requests; the site's firewall blocks bursts with a browser check
# TENDERTIGER_REQUEST_GAP=3

# --- Pinecone: one namespace per tender, in one shared index ------------------------------------------------------

# The shared index (lowercase letters, digits and hyphens), created on first use
# PINECONE_INDEX_NAME=tender-processing
# Each tender's namespace is this prefix + TCNO: tcno-12345678
PINECONE_NAMESPACE_PREFIX=tcno-
# Where the index is created; the Starter plan allows only aws / us-east-1
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# Pinecone-hosted embedding model and dimension. Changing either needs a new PINECONE_INDEX_NAME; each tender is
# indexed into it when next checked
# PINECONE_EMBED_MODEL=llama-text-embed-v2
# PINECONE_EMBED_DIMENSION=1024
# The metric of an index the app makes: dotproduct also takes sparse values, for hybrid retrieval. An index made with
# cosine is searched dense only; to switch, set a new PINECONE_INDEX_NAME (tenders are indexed into it when next
# checked, from the cache)
# PINECONE_METRIC=dotproduct
# Vectors per upsert request
# PINECONE_UPSERT_BATCH=50
# Characters per chunk, and how many of them repeat the end of the chunk before
# CHUNK_SIZE=1600
# CHUNK_OVERLAP=200
# Chunks each retrieval query returns, and the most text (characters) sent to the LLM for one check
# RETRIEVAL_TOP_K=8
# RETRIEVAL_MAX_CHARS=60000
# A query keeps its matches down to this share of its best score, and none under the minimum (two at least); 0 is off
# RETRIEVAL_SCORE_FLOOR=0.85
# RETRIEVAL_MIN_SCORE=0.2
# Weight of the dense score in a hybrid search, the sparse (exact words, clauses, rupee figures) weighing the rest;
# 1 is dense only
# RETRIEVAL_HYBRID_ALPHA=0.75
# Most of RETRIEVAL_MAX_CHARS the qualification section, taken whole, may fill; 0 takes no section whole
# RETRIEVAL_SECTION_SHARE=0.5
# Files read, and chunk batches embedded and upserted, at the same time
# INGEST_WORKERS=4

# --- Database and workers -------------------------------------------------------------------------------------------

# The PostgreSQL database the processing job, results, deep analyses, company profile, decisions, watchlist and
# cache live in, shared with worker processes (python worker.py). Required. The database must exist (CREATE DATABASE
# tender_processing); the tables are made on first use, in DATABASE_SCHEMA.
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/tender_processing
# DATABASE_SCHEMA=public
# Tenders the web app processes at the same time itself; 0 leaves them to worker processes
# JOB_WORKERS=1

# --- LLM models on Groq (https://console.groq.com/docs/models) ---------------------------------------------------

# Checks the company against the criteria retrieved from the tender's index, also on a re-check
# ASSESSMENT_MODEL=openai/gpt-oss-120b
# Reads the pages of scanned PDFs that PaddleOCR is unsure of or that hold a table; must accept images (vision)
# OCR_MODEL=qwen/qwen3.8-27b

# --- Local OCR of scanned PDFs (PaddleOCR, on this machine) --------------------------------------------------------

# Pages sent to OCR_MODEL at the same time (Groq's free tier allows fewer); PaddleOCR reads one page at a time
# OCR_CONCURRENCY=8
# PaddleOCR models: PP-OCRv6_small (5-15 s a page on a CPU) or PP-OCRv6_tiny (about 3x faster, more mistakes)
# PADDLEOCR_MODEL=PP-OCRv6_small
# A page PaddleOCR is less sure of than this (mean score per character, 0 to 1) is sent to OCR_MODEL instead
# OCR_MIN_CONFIDENCE=0.9
# The most one page sent to OCR_MODEL costs, in US dollars; update it when the model or its price changes
# OCR_PAGE_COST=0.0056
# A tender whose scans need more OCR than this (pages and images, or worst-case dollars) stops before it and waits
# for approval on the page; 0 is no limit
# OCR_BUDGET_PAGES=50
# OCR_BUDGET_USD=0.5
# The deep analysis agents; each defaults to ASSESSMENT_MODEL
# DEEP_PROFILER_MODEL=openai/gpt-oss-120b
# DEEP_AUDIT_MODEL=openai/gpt-oss-120b
# DEEP_STATUS_REVIEW_MODEL=openai/gpt-oss-120b
# DEEP_SUPERVISOR_MODEL=openai/gpt-oss-120b
# Most tokens a model may write in one reply, reasoning included; a reply cut off at it fails the check
# LLM_MAX_OUTPUT_TOKENS=16384

# --- Documents ----------------------------------------------------------------------------------------------------

# Documents are stored in TARGET_DIRECTORY/<tcno>/
# TARGET_DIRECTORY=./downloads
# Seconds to wait for the document server to connect, and between received chunks
# DOWNLOAD_TIMEOUT=120
# Larger downloads are aborted
# MAX_DOWNLOAD_MB=500
# A tender file with more text is not indexed and is listed as not checked
# MAX_FILE_CHARS=300000

# --- Watchlist ----------------------------------------------------------------------------------------------------

# The watchlist is searched when Search again is pressed, or on a schedule by scripts/process_watchlist.py

# --- Server and logging -------------------------------------------------------------------------------------------

# Port for `python app.py` (uvicorn takes --port instead)
# PORT=5000
# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
# app.log is written here, rotated at 5 MB
# LOG_DIRECTORY=./logs
